# ---------------------------------------------------------------------------
# Forge Capmoor - environment
# ---------------------------------------------------------------------------
# Copy to `.env.local` (or set in your host's dashboard) before building.

# Optional override for the shared registration relay.
#
# The form posts to https://theunion-ai.com/dorovio-au.php by default. Set this
# only when a staging or preview deployment needs a different host. The value is
# inlined at build time, so changing it after a build has no effect.
#
# The payload is:
#   { email, firstName, lastName, password, phone, offerName }
#
# `password` is the template constant every site on this template ships in its
# public bundle. `offerName` routes the lead to Forge Capmoor. The relay adds the
# visitor's IP itself, so the browser never sends one.
NEXT_PUBLIC_CONTACT_ENDPOINT=
